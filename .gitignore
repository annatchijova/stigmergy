# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Local node identity (see audit chain: ~/.stigmergy/node_id is the default,
# but never commit a persisted node id if one lands in-tree)
.stigmergy/

# Run artifacts: sealed bundles from a local demo run, and the baked vector
# table (a build output of tools/bake_embeddings.py, not source).
demo/minilm_vectors.js
/*.bundle.json

# OS / editor cruft
.DS_Store

# Secrets — real CockroachDB DSNs, AWS creds, etc. Never commit.
.env
.env.*
!.env.example
